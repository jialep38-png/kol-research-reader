{"channelId":"UC2nkRzPnFbbWIyCYvH_9JlA","row":["Goat Daddys",690000,"Goat Daddy's is a Grade A Goat Dairy, 501c3 animal sanctuary, and Airbnb located in central South Carolina. Nubian and Nigerian Dwarf goats make up the herd of nearly 60 goats and their high butterfat and eager browsing habits are what give the cheese its phenomenal taste. In addition to being a farm, Goat Daddy’s has worked with local vets, DNR, and rescues over the years and aided in providing a forever home to a plethora of animal species ranging from avian, camelid, equine, and reptiles.","","United States"],"channelUrl":"https://www.youtube.com/channel/UC2nkRzPnFbbWIyCYvH_9JlA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UC2nkRzPnFbbWIyCYvH_9JlA","observedAt":"2026-09-18T12:18:15.793Z"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UC2nkRzPnFbbWIyCYvH_9JlA","observedAt":"2026-09-18T12:18:15.793Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UC2nkRzPnFbbWIyCYvH_9JlA","identityStatus":"channel_published","value":690000,"raw":"690K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UC2nkRzPnFbbWIyCYvH_9JlA","observedAt":"2026-09-18T12:18:15.793Z"}],"emails":[],"contactPages":[{"url":"https://www.airbnb.com/help/contact-us/logged-out","hasForm":false,"observedAt":"2026-09-18T13:31:06.862Z"}],"matchedKeywords":["veterinary","veterinarian","animal rescue"],"relevantKeywords":[],"priorityKeywords":[],"quality":[{"keyword":"veterinary","relevant":false,"evidenceLevel":"unconfirmed","role":"undetermined","flags":[],"sourceUrls":[]},{"keyword":"veterinarian","relevant":false,"evidenceLevel":"unconfirmed","role":"undetermined","flags":["当前仅有相关内容或名称线索，尚无匹配的本人专业简介；不列入职业联系优选"],"sourceUrls":[]},{"keyword":"animal rescue","relevant":false,"evidenceLevel":"unconfirmed","role":"undetermined","flags":[],"sourceUrls":[]}]}