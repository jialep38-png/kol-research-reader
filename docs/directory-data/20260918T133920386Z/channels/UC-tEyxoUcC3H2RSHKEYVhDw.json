{"channelId":"UC-tEyxoUcC3H2RSHKEYVhDw","row":["Dr. Travis McDermott - Vegas Vet",4250,"I have been a small animal veterinarian in Las Vegas, NV for 15 years, and have been at Durango Animal Hospital for the past 6 years.  I couldn't imagine doing anything other than this, but the old saying about \"the good, the bad, and the ugly\" applies well to being a veterinarian (except occasionally you might need to add in \"the nasty\").  My goal is to take you on a journey that shows you day-to-day life as a veterinarian including what it is like to do it in a busy clinic in Las Vegas.  Hope you enjoy it.","","United States"],"channelUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","observedAt":"2026-09-18T08:36:29.027Z"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","observedAt":"2026-09-18T08:36:29.027Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","identityStatus":"channel_published","value":4250,"raw":"4.25K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","observedAt":"2026-09-18T12:03:36.496Z"}],"emails":[],"contactPages":[],"matchedKeywords":["veterinary","veterinarian"],"relevantKeywords":["veterinary","veterinarian"],"priorityKeywords":[],"quality":[{"keyword":"veterinary","relevant":true,"evidenceLevel":"profile","role":"organization_self_report","flags":[],"sourceUrls":["https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw"]},{"keyword":"veterinarian","relevant":true,"evidenceLevel":"profile","role":"organization_self_report","flags":[],"sourceUrls":["https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw"]}]}