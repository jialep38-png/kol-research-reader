{"channelId":"UCzAuczZHeat2cm8E2Xf2e3g","row":["University of Lancashire",14900,"We are an international, multi-campus university tracing its roots back to 1828 and leading the way in modern learning today. Our vision is to create a world-class campus for the benefit of students, staff and the surrounding community.\n\nToday we're one of the UK’s largest universities with a staff and student community approaching 42,000. Our employment-focused course portfolio with over 350 undergraduate programmes, nearly 200+ postgraduate courses and rich array of CPD courses means we offer our students the skills and experience that industry needs.\n\nThe University of Lancashire is the most affordable university in the country according to The Times (2023).","enquiry@hkct.edu.hk; info@eue.edu.eg; info@icem.edu.om; info@rlesc.qa; info@ucl.lk; admin@uzhnu.edu.ua; admission@ucbbd.org; AUCInternational@aucmed.edu; contactus@uomenterprise.ac.mu; eception@icps.edu.gr; hbuuclan5073393@163.com; iie@gdufs.edu.cn; infokd@segi.edu.my; media@uzhnu.edu.ua; official@uzhnu.edu.ua; oiec@hunnu.edu.cn; penquiries@uclan.ac.uk; reception@icps.edu.gr; scope@cityu.edu.hk; shape@vtc.edu.hk; siftls@163.com; wangying318@gmail.com; yingwang@bit.edu.cn","United Kingdom"],"channelUrl":"https://www.youtube.com/channel/UCzAuczZHeat2cm8E2Xf2e3g","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCzAuczZHeat2cm8E2Xf2e3g","observedAt":"2026-09-18T12:23:09.715Z"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCzAuczZHeat2cm8E2Xf2e3g","observedAt":"2026-09-18T12:23:09.715Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCzAuczZHeat2cm8E2Xf2e3g","identityStatus":"channel_published","value":14900,"raw":"14.9K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCzAuczZHeat2cm8E2Xf2e3g","observedAt":"2026-09-18T12:23:09.715Z"}],"emails":[{"address":"enquiry@hkct.edu.hk","purpose":"general","ownerRole":"unknown","identitySta