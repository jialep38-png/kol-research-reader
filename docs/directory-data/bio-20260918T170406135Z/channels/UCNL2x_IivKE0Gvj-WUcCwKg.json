{"channelId":"UCNL2x_IivKE0Gvj-WUcCwKg","row":["C Double Stables",17,"C Double Stables is a family owned and operated equestrian facility located in Dawson Creek, BC, CA. We have a diverse skillset among our team which includes multiple certified Equine Canada Coaches, access to ground training, horse starting, as well as equine physiotherapy and rehabilitation. Our barn is also very fortunate to have access to our own equine vet. We pride ourselves in continuous learning and putting our horses health and wellbeing first, while keeping rider awareness and safety at the forefront of our program. We hope with this channel that viewers will gain knowledge in an easy accessible way to consistently improve their ride.","","Canada"],"channelUrl":"https://www.youtube.com/channel/UCNL2x_IivKE0Gvj-WUcCwKg","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCNL2x_IivKE0Gvj-WUcCwKg","observedAt":"2026-09-18T12:07:36.000Z","channelId":"UCNL2x_IivKE0Gvj-WUcCwKg","sourceType":"about","contentHash":"c2b5172813aa436d130c42e18e4b310a880332a9a75b19c4bb22602dd2b5dbdd","complete":true,"readStatus":"read","captureSha256":"ce51bb36ec9172d17f81b484356fa7b6667c1e14d7f799658012e32aec6c9335"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCNL2x_IivKE0Gvj-WUcCwKg","observedAt":"2026-09-18T12:07:36.000Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCNL2x_IivKE0Gvj-WUcCwKg","identityStatus":"channel_published","value":17,"raw":"17 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCNL2x_IivKE0Gvj-WUcCwKg","observedAt":"2026-09-18T12:07:36.000Z"}],"emails":[],"contactPages":[],"matchedKeywords":["physical therapist","equestrian"],"relevantKeywords":["physical therapist","equestrian"],"priorityKeywords":[],"quality":[{"keyword":"physical therapist","relevant":true,"evidenceLevel":"profile","role":"undetermined","flags":[],"sourceUrls":["https://www.youtube.com/channel/UCNL2x_IivKE0Gvj-WUcCwKg"]}],"clea