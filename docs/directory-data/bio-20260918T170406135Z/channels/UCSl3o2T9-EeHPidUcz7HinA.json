{"channelId":"UCSl3o2T9-EeHPidUcz7HinA","row":["Life With Pigs Farm Animal Sanctuary",73100,"Live at 9pm ET nightly.  Life with Pigs Farm Animal Sanctuary provides forever homes to farm animals in need and compassion-filled educational experiences to the public.  We are home to pigs, cows, turkeys, chickens, sheep, a rabbit, a parrot, and three dogs. \n\nLife with Pigs is dedicated to educating people about the injustices faced by animals and how we can better coexist with our fellow earthlings. We operate under the guiding principle that animals are our equals and deserve equal consideration for their needs and desires.\n\nPlease subscribe to our channel for regular videos!","","United States"],"channelUrl":"https://www.youtube.com/channel/UCSl3o2T9-EeHPidUcz7HinA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCSl3o2T9-EeHPidUcz7HinA","observedAt":"2026-09-18T12:02:28.757Z","channelId":"UCSl3o2T9-EeHPidUcz7HinA","sourceType":"about","contentHash":"9dc8ea4d8afc4b8e4b3d27ba03be3a0c4857d496dde43f7846d7dadf1cdd2262","complete":true,"readStatus":"read","captureSha256":"ac8745a0823934d7f11daa22f16eab07a6d8c095cfaf6bc7182a6b96e145d03a"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCSl3o2T9-EeHPidUcz7HinA","observedAt":"2026-09-18T09:20:25.848Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCSl3o2T9-EeHPidUcz7HinA","identityStatus":"channel_published","value":73100,"raw":"73.1K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCSl3o2T9-EeHPidUcz7HinA","observedAt":"2026-09-18T12:02:28.757Z"}],"emails":[],"contactPages":[],"matchedKeywords":["animal rescue"],"relevantKeywords":["animal rescue"],"priorityKeywords":[],"quality":[{"keyword":"animal rescue","relevant":true,"evidenceLevel":"profile","role":"undetermined","flags":[],"sourceUrls":["https://www.youtube.com/channel/UCSl3o2T9-EeHPidUcz7HinA"]}],"cleanup":{"status":"keep","code":"biography_audience_admitted","reaso