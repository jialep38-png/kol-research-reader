{"channelId":"UCwrd4EsHKfYTzBOHtq07oIQ","row":["AIC Singapore",26100,"The Agency for Integrated Care (AIC) aims to create a vibrant care community for people to live well and age gracefully. AIC coordinates and supports efforts in integrating care to achieve the best care outcomes for our clients. We reach out to caregivers and seniors with information on staying active and ageing well, and connect people to services they need. We support stakeholders in their efforts to raise the quality of care, and also work with health and social care partners to provide services for the ageing population. Our work in the community brings care services and information closer to those in need. For more about us, please visit https://www.aic.sg.","","Singapore"],"channelUrl":"https://www.youtube.com/channel/UCwrd4EsHKfYTzBOHtq07oIQ","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCwrd4EsHKfYTzBOHtq07oIQ","observedAt":"2026-09-18T12:22:44.844Z","channelId":"UCwrd4EsHKfYTzBOHtq07oIQ","sourceType":"about","contentHash":"11a02903fd714d057657f82f257e2f4a7a1146ee86b599d83ee326956577a633","complete":true,"readStatus":"read","captureSha256":"b1b584a5970a2e49d44574ac13c9cc45275f956bfc17d8743cd9db40d4c567f8"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCwrd4EsHKfYTzBOHtq07oIQ","observedAt":"2026-09-18T12:22:44.844Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCwrd4EsHKfYTzBOHtq07oIQ","identityStatus":"channel_published","value":26100,"raw":"26.1K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCwrd4EsHKfYTzBOHtq07oIQ","observedAt":"2026-09-18T12:22:44.844Z"}],"emails":[],"contactPages":[],"matchedKeywords":[],"relevantKeywords":[],"priorityKeywords":[],"quality":[{"keyword":"physical therapist","relevant":false,"evidenceLevel":"single_sample","role":"undetermined","flags":["当前仅有相关内容或名称线索，尚无匹配的本人专业简介；不列入职业联系优选"],"sourceUrls":["https://www.youtube.com/watch?v=w7lnLualWxY"]}],"cleanup":{