{"channelId":"UCS_i9hGUSF3D0G9W9PoDEmw","row":["Youth Cinema Project",4390,"YCP brings industry professionals directly into the most underserved classrooms across the state, partnering with school districts to integrate our curriculum into public schools from 5th to 12th grade. Each class is conducted twice a week in ninety-minute sessions throughout the school year. Unlike any other program in the country, our approach is not an after-school program; it is an in-class, push-in model. What sets our program apart is our belief in the students’ potential to meet high expectations. We guide them through the entire filmmaking process – from story development and production to post production – and culminate with industry screenings at the end of the year.\n\nLearn more at: youthcinemaproject.org","","United States"],"channelUrl":"https://www.youtube.com/channel/UCS_i9hGUSF3D0G9W9PoDEmw","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCS_i9hGUSF3D0G9W9PoDEmw","observedAt":"2026-09-18T12:21:53.778Z","channelId":"UCS_i9hGUSF3D0G9W9PoDEmw","sourceType":"about","contentHash":"f6156fae7cfe1573f32e4ffcddb3496675e41f311138e61e7eb6822309893385","complete":true,"readStatus":"read","captureSha256":"34491f914131aa783882f105f30faec60b674dc19680cfbb84e1464ce5ce092a"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCS_i9hGUSF3D0G9W9PoDEmw","observedAt":"2026-09-18T12:21:53.778Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCS_i9hGUSF3D0G9W9PoDEmw","identityStatus":"channel_published","value":4390,"raw":"4.39K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCS_i9hGUSF3D0G9W9PoDEmw","observedAt":"2026-09-18T12:21:53.778Z"}],"emails":[],"contactPages":[],"matchedKeywords":[],"relevantKeywords":[],"priorityKeywords":[],"quality":[{"keyword":"animal rescue","relevant":false,"evidenceLevel":"unconfirmed","role":"undetermined","flags":[],"sourceUrls":[]}],"cleanup":{"status":"review","code"