{"channelId":"UC3Hkj5S1SgXClCc9M3joniQ","row":["DASH Chiropractic",1720,"The purpose of this site is to inform and educate patients of DASH Chiropractic about healthy living, injuries and rehabilitation. DASH Chiropractic uses chiropractic care, strength training, neuromuscular re-education, functional medicine, nutrition, and various manual soft tissue therapies to facilitate healing and injury prevention in our patients. We aim to help patients with all conditions, but most especially IT Band Syndrome, Sciatica, Disc Herniations, Piriformis Syndrome, Groin Pain, Hip Pain, Low Back Pain, Neck Pain, Shoulder Pain, and Knee Pain. Move Well, Be Well.\n\nWe are located in Huntington Beach, CA.","","United States"],"channelUrl":"https://www.youtube.com/channel/UC3Hkj5S1SgXClCc9M3joniQ","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UC3Hkj5S1SgXClCc9M3joniQ","observedAt":"2026-09-18T12:04:08.659Z","channelId":"UC3Hkj5S1SgXClCc9M3joniQ","sourceType":"about","contentHash":"6e22baef0a25ae1eba90277621eb399b1d26d002ee1d3ad4800e858bbaf1e082","complete":true,"readStatus":"read","captureSha256":"0ac09a408c768b4eea7cf60de3fa0d6c7ac9e1a43f439f789f5284cc29e720aa"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UC3Hkj5S1SgXClCc9M3joniQ","observedAt":"2026-09-18T08:47:24.290Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UC3Hkj5S1SgXClCc9M3joniQ","identityStatus":"channel_published","value":1720,"raw":"1.72K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UC3Hkj5S1SgXClCc9M3joniQ","observedAt":"2026-09-18T12:04:08.659Z"}],"emails":[],"contactPages":[],"matchedKeywords":["chiropractors"],"relevantKeywords":["chiropractors"],"priorityKeywords":[],"quality":[{"keyword":"chiropractors","relevant":true,"evidenceLevel":"profile","role":"undetermined","flags":[],"sourceUrls":["https://www.youtube.com/channel/UC3Hkj5S1SgXClCc9M3joniQ"]}],"cleanup":{"status":"keep","code":"biography_audience_a