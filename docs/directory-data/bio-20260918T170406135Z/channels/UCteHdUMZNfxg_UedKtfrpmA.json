{"channelId":"UCteHdUMZNfxg_UedKtfrpmA","row":["Equi-Ice",24,"Equi-Ice Is the simplest and most effective ice pack/ cold therapy product designed specifically for horses that provides direct delivery of ice to targeted areas. Equi-Ice is a durable and re-useable ice pack that delivers immediate benefits of direct icing to the horse’s spine and back muscles. Created by leading Australian equine physiotherapist, Tom Simpson (physiotom.com.au), Equi-Ice can be used routinely by horse owners to promote faster recovery post-exercise or injury.\nFurther information is available at www.equi-ice.com.au.  From Australia, call 1300  755 516. Email inquiries to info@equi-ice.com.au.","info@equi-ice.com.au",""],"channelUrl":"https://www.youtube.com/channel/UCteHdUMZNfxg_UedKtfrpmA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCteHdUMZNfxg_UedKtfrpmA","observedAt":"2026-09-18T12:01:42.261Z","channelId":"UCteHdUMZNfxg_UedKtfrpmA","sourceType":"about","contentHash":"146927f97307c03f9ab7b25408730f1d512570a54fd634057eea90056a7f6500","complete":true,"readStatus":"read","captureSha256":"d15f10dd7877d3432d3b525b6f277ecabc347c0a1249ff4d8cee4b38200c3b6d"},"countrySource":{},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCteHdUMZNfxg_UedKtfrpmA","identityStatus":"channel_published","value":24,"raw":"24 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCteHdUMZNfxg_UedKtfrpmA","observedAt":"2026-09-18T12:01:42.261Z"}],"emails":[{"address":"info@equi-ice.com.au","purpose":"general","ownerRole":"unknown","identityStatus":"channel_published","sourceUrls":["https://www.youtube.com/channel/UCteHdUMZNfxg_UedKtfrpmA"],"evidenceIds":["contact:09f4924ea00d467825bf2c5c","completion:0b554d8d9f055e1189208c68"],"observedAt":"2026-09-16T04:18:19.949Z","deliveryVerified":false,"dnsStatus":"unknown"}],"contactPages":[{"url":"https://www.equi-ice.com.au/contact-us/","hasForm":true,"observedAt":"2026-09-18T12:45:22.537Z"}],"