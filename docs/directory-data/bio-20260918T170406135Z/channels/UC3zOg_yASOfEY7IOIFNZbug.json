{"channelId":"UC3zOg_yASOfEY7IOIFNZbug","row":["Lost Dog and Cat Rescue Foundation",431,"LDCRF is a Virginia based rescue organization that helps homeless and abandoned animals find permanent, loving homes. We reduce pet overpopulation by spaying or neutering every pet in our care before we put him or her up for adoption. The animals at our rescue are pulled from crowded rural shelters, where their chances of being adopted are very slim. \r\n\r\nPlease watch our videos for more information about Lost Dog and Cat Rescue, and check out our website at www.lostdogrescue.org for even more information!","",""],"channelUrl":"https://www.youtube.com/channel/UC3zOg_yASOfEY7IOIFNZbug","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UC3zOg_yASOfEY7IOIFNZbug","observedAt":"2026-09-18T12:05:04.927Z","channelId":"UC3zOg_yASOfEY7IOIFNZbug","sourceType":"about","contentHash":"e6e17c29622206026c8cd350060106a642fd6f34ac29f619c21e9958e880adb8","complete":true,"readStatus":"read","captureSha256":"c3c5ea313d21e973f60ab33f707732669475ab18d57323805000b61f9b4575a9"},"countrySource":{},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UC3zOg_yASOfEY7IOIFNZbug","identityStatus":"channel_published","value":431,"raw":"431 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UC3zOg_yASOfEY7IOIFNZbug","observedAt":"2026-09-18T12:05:04.927Z"}],"emails":[],"contactPages":[{"url":"https://www.lostdogrescue.org/","hasForm":true,"observedAt":"2026-09-18T12:35:16.168Z"},{"url":"https://www.lostdogrescue.org/about/friends-of-ldcrf/partners/","hasForm":true,"observedAt":"2026-09-18T12:35:16.999Z"},{"url":"https://www.lostdogrescue.org/about/contact-us/","hasForm":true,"observedAt":"2026-09-18T12:35:19.073Z"},{"url":"https://www.lostdogrescue.org/about/friends-of-ldcrf/petco-love-lost/","hasForm":true,"observedAt":"2026-09-18T12:35:19.799Z"},{"url":"https://www.lostdogrescue.org/about/","hasForm":true,"observedAt":"2026-09-18T12:35:2