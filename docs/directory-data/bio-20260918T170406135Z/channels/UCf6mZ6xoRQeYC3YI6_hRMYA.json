{"channelId":"UCf6mZ6xoRQeYC3YI6_hRMYA","row":["Animal Rescue Haven",26600,"Welcome to Animal Rescue Haven 🐾\n\nAnimal Rescue Haven is where you can discover heartwarming real-life animal rescue stories from around the world.\n\nHere, you'll find inspiring rescue stories, miraculous recoveries, touching reunions, and loving moments that celebrate compassion, courage, and the extraordinary bond between humans and animals.\n\nOur goal is to share inspiring stories of kindness, raise awareness about animal protection, and remind everyone that every life is precious, deserves love, care, and a second chance.\n\nEvery rescue has a story.\n\nThank you for being a part of our community and helping us spread hope—one story at a time.","","United States"],"channelUrl":"https://www.youtube.com/channel/UCf6mZ6xoRQeYC3YI6_hRMYA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCf6mZ6xoRQeYC3YI6_hRMYA","observedAt":"2026-09-18T12:02:45.663Z","channelId":"UCf6mZ6xoRQeYC3YI6_hRMYA","sourceType":"about","contentHash":"3a4baad0713ffbd9f1a570d7fe250037aa1f0b923ea1e2c3a702389dd9c2d73e","complete":true,"readStatus":"read","captureSha256":"7fdb836eb8f76fc19aaa62e22dfc318c4c13c25a2d5f7bbdbf03891ab68256bc"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCf6mZ6xoRQeYC3YI6_hRMYA","observedAt":"2026-09-18T09:22:52.853Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCf6mZ6xoRQeYC3YI6_hRMYA","identityStatus":"channel_published","value":26600,"raw":"26.6K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCf6mZ6xoRQeYC3YI6_hRMYA","observedAt":"2026-09-18T12:02:45.663Z"}],"emails":[],"contactPages":[],"matchedKeywords":["animal rescue"],"relevantKeywords":["animal rescue"],"priorityKeywords":[],"quality":[{"keyword":"animal rescue","relevant":true,"evidenceLevel":"profile","role":"organization_self_report","flags":[],"sourceUrls":["https://www.youtube.com/channel/UCf6mZ6xoRQeYC3YI6_hRMYA"]}],"clean