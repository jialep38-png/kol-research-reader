{"channelId":"UCIaPCt8t4CeGNElyAYEuffw","row":["Vet Nurse Plus",45,"Welcome to the Vet Nurse Plus Youtube webinar channel \n\nAbout Vet Nurse Plus\nVet Nurse Plus is a private training establishment that has one focus - training veterinary nurses. We aim to provide outstanding veterinary nurse graduates to the veterinary industry, who can hit the ground running upon employment. First launched in 2005, programmes are highly practical and graduate outcome-based, incorporating feedback and input from the industry that employs our students. This in turn leads to high demand for our graduates and excellent levels of employment. Well over 70% of our graduates are hired within six months of graduation.","info@vetnurseplus.co.nz","New Zealand"],"channelUrl":"https://www.youtube.com/channel/UCIaPCt8t4CeGNElyAYEuffw","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCIaPCt8t4CeGNElyAYEuffw","observedAt":"2026-09-18T12:07:02.609Z","channelId":"UCIaPCt8t4CeGNElyAYEuffw","sourceType":"about","contentHash":"47d0e93750610bb145385c8fae6e48c2f8872c01202469b47528b654125fb285","complete":true,"readStatus":"read","captureSha256":"b02587b460cd919608d65769275bf60f9b2adffaec02619b1162dc69dc044430"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCIaPCt8t4CeGNElyAYEuffw","observedAt":"2026-09-18T12:07:02.609Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCIaPCt8t4CeGNElyAYEuffw","identityStatus":"channel_published","value":45,"raw":"45 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCIaPCt8t4CeGNElyAYEuffw","observedAt":"2026-09-18T12:07:02.609Z"}],"emails":[{"address":"info@vetnurseplus.co.nz","purpose":"general","ownerRole":"unknown","identityStatus":"channel_published","sourceUrls":["https://www.vetnurseplus.co.nz/contact-us/","https://www.vetnurseplus.co.nz/"],"evidenceIds":["public-page:4709e8338b297aa8a0a26608","public-page:8d14d98f841af82036178705"],"observedAt":"2026-09-18T12:41:59.98