{"channelId":"UCt1E_cYEAzG3DAPRd_h7aAg","row":["Animal Urgent Care",41,"Animal Urgent Care is a 24/7/365 veterinary emergency facility in Arvada, CO. Our expertise allows us to treat your pet with the love and care we give our own, and we will work our hardest to send them home happy and healthy. We strive to keep compassion, cost-consciousness, and excellent service at the forefront of each and every case we see. We have decades of emergency and critical care experience and our staff regularly exceed continuing education standards. We are proudly certified by the American Animal Hospital Association.\n\nSubscribe to our channel for veterinary educational \"How To\" videos, hospital updates and information about our services and pets.","","US"],"channelUrl":"https://www.youtube.com/channel/UCt1E_cYEAzG3DAPRd_h7aAg","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCt1E_cYEAzG3DAPRd_h7aAg","observedAt":"2026-09-18T12:07:06.497Z","channelId":"UCt1E_cYEAzG3DAPRd_h7aAg","sourceType":"about","contentHash":"148b44dcc8c3ebf75f2f04eb0fa78f112985467d0f1866730fcfbf110183fa21","complete":true,"readStatus":"read","captureSha256":"1aea5bef17155b8e53a9b6abc4c84abcad86707a828f70d0a53f232eb39eba83"},"countrySource":{"sourceUrl":"https://www.aucvet.com/","observedAt":"2026-09-18T12:42:03.462Z","method":"self_published_jsonld_addressCountry","entityName":"Animal Urgent Care"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCt1E_cYEAzG3DAPRd_h7aAg","identityStatus":"channel_published","value":41,"raw":"41 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCt1E_cYEAzG3DAPRd_h7aAg","observedAt":"2026-09-18T12:07:06.497Z"}],"emails":[],"contactPages":[{"url":"https://www.aucvet.com/contact-us","hasForm":false,"observedAt":"2026-09-18T12:41:53.918Z"}],"matchedKeywords":["veterinary"],"relevantKeywords":["veterinary"],"priorityKeywords":[],"quality":[{"keyword":"veterinary","relevant":true,"evidenceLevel":"profile