{"channelId":"UCymvSNc4fSYU_9BfpJIOEjQ","row":["Catalyst Physical Therapy",523,"Welcome to Catalyst Physical Therapy! We specialize in pelvic health and orthopedic physical therapy, helping active adults, especially moms, move confidently and live without pain. Our expert, hands-on approach focuses on finding and treating the root cause of dysfunction—not just the symptoms—so you can achieve lasting results. As part of our commitment to health and wellness, we share exercise instruction videos to empower everyone with the tools they need to feel their best. \n\nIf you need personalized care, call our office today to schedule an in-person or telehealth appointment!","admin@catalyst-physicaltherapy.com; amberbartz@catalyst-physicaltherapy.com","US"],"channelUrl":"https://www.youtube.com/channel/UCymvSNc4fSYU_9BfpJIOEjQ","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCymvSNc4fSYU_9BfpJIOEjQ","observedAt":"2026-09-18T12:04:57.137Z","channelId":"UCymvSNc4fSYU_9BfpJIOEjQ","sourceType":"about","contentHash":"50c253c6952c28e14873d3775da637dffd625a3c33edef2d82f4b33a37557db7","complete":true,"readStatus":"read","captureSha256":"0cd3378488bf0c61df3201913d091064f8619faf01d2aeaab80d897472efdc79"},"countrySource":{"sourceUrl":"https://www.catalyst-physicaltherapy.com/","observedAt":"2026-09-18T12:34:40.609Z","method":"self_published_jsonld_addressCountry","entityName":"Catalyst Physical Therapy"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCymvSNc4fSYU_9BfpJIOEjQ","identityStatus":"channel_published","value":523,"raw":"523 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCymvSNc4fSYU_9BfpJIOEjQ","observedAt":"2026-09-18T12:04:57.137Z"}],"emails":[{"address":"admin@catalyst-physicaltherapy.com","purpose":"unknown","ownerRole":"unknown","identityStatus":"cross_linked","sourceUrls":["https://www.catalyst-physicaltherapy.com/","https://www.catalyst-physicaltherapy.com/about-4"],"evidenceIds":["publi