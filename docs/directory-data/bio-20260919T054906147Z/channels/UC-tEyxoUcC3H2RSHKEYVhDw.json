{"channelId":"UC-tEyxoUcC3H2RSHKEYVhDw","row":["Dr. Travis McDermott - Vegas Vet",4250,"I have been a small animal veterinarian in Las Vegas, NV for 15 years, and have been at Durango Animal Hospital for the past 6 years.  I couldn't imagine doing anything other than this, but the old saying about \"the good, the bad, and the ugly\" applies well to being a veterinarian (except occasionally you might need to add in \"the nasty\").  My goal is to take you on a journey that shows you day-to-day life as a veterinarian including what it is like to do it in a busy clinic in Las Vegas.  Hope you enjoy it.","","United States"],"channelUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","observedAt":"2026-09-18T12:03:36.496Z","channelId":"UC-tEyxoUcC3H2RSHKEYVhDw","sourceType":"about","contentHash":"f9288aa2ca7be234014f3ba588f4b4f93304b4bf8b0bb5c00aef03f07f901ff3","complete":true,"readStatus":"read","captureSha256":"50d8244fee322183caf9d4a2ba559ec2ea24e70456fe0b150197718418198d40"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","observedAt":"2026-09-18T08:36:29.027Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","identityStatus":"channel_published","value":4250,"raw":"4.25K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw","observedAt":"2026-09-18T12:03:36.496Z"}],"emails":[],"contactPages":[],"matchedKeywords":["veterinary"],"relevantKeywords":["veterinary"],"priorityKeywords":[],"quality":[{"keyword":"veterinary","relevant":true,"evidenceLevel":"profile","role":"organization_self_report","flags":[],"sourceUrls":["https://www.youtube.com/channel/UC-tEyxoUcC3H2RSHKEYVhDw"]},{"keyword":"veterinarian","relevant":true,"evidenceLevel":"profile","role":"organization_self_report","flags":[],"sourceUrls":["https://www.youtube