{"channelId":"UCpEV00hZW8j0sOkiDYFKglg","row":["Dr. Chris Gubbels | The Scoliosis Specialist",1880,"Dr. Chris Gubbels is a scoliosis specialist at ScoliCare Denver with 18+ years of experience treating over 6,500 patients. This channel is for parents of children with scoliosis and adults living with scoliosis or hyperkyphosis who want real answers about non-surgical treatment options.\n\nLearn about scoliosis bracing, scoliosis-specific exercises, curve progression, early detection, and how to avoid surgery. Dr. Gubbels covers what works, what does not, and what your doctor may not be telling you.\n\nNew videos weekly on scoliosis treatment, warning signs, bracing myths, and spinal health.","","United States"],"channelUrl":"https://www.youtube.com/channel/UCpEV00hZW8j0sOkiDYFKglg","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCpEV00hZW8j0sOkiDYFKglg","observedAt":"2026-09-18T12:21:22.620Z","channelId":"UCpEV00hZW8j0sOkiDYFKglg","sourceType":"about","contentHash":"e438be73bbe198baa6c7b002546a33574675008fc082e4c61978931e745b5d69","complete":true,"readStatus":"read","captureSha256":"a6cc2e32b44d5d9badd265cffbe03c3cdfe3c27d6978ddf41c6394f841fc049b"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCpEV00hZW8j0sOkiDYFKglg","observedAt":"2026-09-18T12:21:22.620Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCpEV00hZW8j0sOkiDYFKglg","identityStatus":"channel_published","value":1880,"raw":"1.88K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCpEV00hZW8j0sOkiDYFKglg","observedAt":"2026-09-18T12:21:22.620Z"}],"emails":[],"contactPages":[],"matchedKeywords":[],"relevantKeywords":[],"priorityKeywords":[],"quality":[{"keyword":"chiropractors","relevant":false,"evidenceLevel":"single_sample","role":"undetermined","flags":["当前仅有相关内容或名称线索，尚无匹配的本人专业简介；不列入职业联系优选"],"sourceUrls":["https://www.youtube.com/watch?v=e1IIVYIPqmI"]}],"cleanup":{"status":"review","code":"biography_audience