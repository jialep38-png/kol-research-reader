{"channelId":"UC3t9Aqu4cDTqFnF1p_An8CA","row":["Dan The Veterinarian",27600,"My name is Dan, and I am a veterinarian.  I love animals and the people that take care of them.  I started this station to provide veterinary knowledge and stories about my experience as a veterinarian.  I believe that pets make our lives better, and the more knowledge we have about them the better we can care for them.  Thank you so much for watching and sharing your comments on my station!\n\nPlease feel free to leave questions and comments about your pets.  I will do my very best to provide information and knowledge regarding all questions.  As a veterinarian I am not able to diagnose or treat any animals without seeing them first.  So, please keep all questions about the topic, and do not ask about your pet directly.  Thanks!","","United States"],"channelUrl":"https://www.youtube.com/channel/UC3t9Aqu4cDTqFnF1p_An8CA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UC3t9Aqu4cDTqFnF1p_An8CA","observedAt":"2026-09-18T12:02:45.124Z","channelId":"UC3t9Aqu4cDTqFnF1p_An8CA","sourceType":"about","contentHash":"1faa391272a74dd272e5a973124206c527ce4e9e759457f5e57c146cb0aea9c8","complete":true,"readStatus":"read","captureSha256":"cff11cae76ceabeceff8e3b8b63599c7dc2d4c8a7f78198890c99904059724b2"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UC3t9Aqu4cDTqFnF1p_An8CA","observedAt":"2026-09-18T07:58:42.958Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UC3t9Aqu4cDTqFnF1p_An8CA","identityStatus":"channel_published","value":27600,"raw":"27.6K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UC3t9Aqu4cDTqFnF1p_An8CA","observedAt":"2026-09-18T12:02:45.124Z"}],"emails":[],"contactPages":[],"matchedKeywords":["veterinary"],"relevantKeywords":["veterinary"],"priorityKeywords":[],"quality":[{"keyword":"veterinary","relevant":true,"evidenceLevel":"profile","role":"practitioner_self_report","flags":[],"sourceUrl