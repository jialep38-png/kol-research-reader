{"channelId":"UCF82SZQC34RHKVkRrtYfklQ","row":["Vet Doctor PK",90,"Welcome to my channel!\n\nMy name is Dr. Ali Raza, and I am a veterinary doctor (DVM). I belong to a village, Bilot Sharif, in District Dera Ismail Khan KPK.\n\nOn this channel, I will share simple and useful information about animal health, treatment, and care. My goal is to help farmers and animal lovers understand their animals better and keep them healthy.\n\nI will upload videos about common animal diseases, basic treatments, vaccination, feeding tips, and daily care of livestock like cows, buffaloes, goats, and other animals.\n\nThis channel is especially for people in rural areas, where proper veterinary guidance is not always easily available.\n\nStay connected and learn how to take better care of your animals.\n\nThank you for your support!","",""],"channelUrl":"https://www.youtube.com/channel/UCF82SZQC34RHKVkRrtYfklQ","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCF82SZQC34RHKVkRrtYfklQ","observedAt":"2026-09-18T12:06:41.987Z","channelId":"UCF82SZQC34RHKVkRrtYfklQ","sourceType":"about","contentHash":"d6331de503722f565d6f851e9a9426c9136a2294ca3e19c8f7f44a315b1b8d79","complete":true,"readStatus":"read","captureSha256":"338ca35f9cdd517cd3a12b961dae2a041a1b3879afdcdfa9ec9c7291e61208b4"},"countrySource":{},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCF82SZQC34RHKVkRrtYfklQ","identityStatus":"channel_published","value":90,"raw":"90 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCF82SZQC34RHKVkRrtYfklQ","observedAt":"2026-09-18T12:06:41.987Z"}],"emails":[],"contactPages":[],"matchedKeywords":["veterinary"],"relevantKeywords":["veterinary"],"priorityKeywords":[],"quality":[{"keyword":"veterinarian","relevant":true,"evidenceLevel":"profile","role":"practitioner_self_report","flags":[],"sourceUrls":["https://www.youtube.com/channel/UCF82SZQC34RHKVkRrtYfklQ"]}],"cleanup":{"status":"keep","code":"biography_audience