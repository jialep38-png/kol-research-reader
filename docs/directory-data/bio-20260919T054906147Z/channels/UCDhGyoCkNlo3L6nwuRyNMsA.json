{"channelId":"UCDhGyoCkNlo3L6nwuRyNMsA","row":["Raw Feeding Veterinary Society",1520,"The Raw Feeding Veterinary Society is a group of motivated vets, vet nurses and nutrition experts with a common interest in raw feeding and species appropriate nutrition in dogs and cats. It is UK based, but welcome any veterinary professional from around the world. Formed in 2014, it represents another step in the evolution of the recognition of feeding pet animals food they would, logically, have adapted to over millennia in the wild. We are committed to professional, responsible communication, education and research on all areas of nutrition in dogs and cats.","","United Kingdom"],"channelUrl":"https://www.youtube.com/channel/UCDhGyoCkNlo3L6nwuRyNMsA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCDhGyoCkNlo3L6nwuRyNMsA","observedAt":"2026-09-18T12:04:14.383Z","channelId":"UCDhGyoCkNlo3L6nwuRyNMsA","sourceType":"about","contentHash":"7da08e1f7e2bbaa927120c89b7b2ae78c1d51dfbd31ecb190b37ba840d85b926","complete":true,"readStatus":"read","captureSha256":"53495b81d4d032232bf6d6ee66300be3becaaa24c1ddd1dd7e5ce6857ee51f2d"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCDhGyoCkNlo3L6nwuRyNMsA","observedAt":"2026-09-18T12:04:14.383Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCDhGyoCkNlo3L6nwuRyNMsA","identityStatus":"channel_published","value":1520,"raw":"1.52K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCDhGyoCkNlo3L6nwuRyNMsA","observedAt":"2026-09-18T12:04:14.383Z"}],"emails":[],"contactPages":[{"url":"https://rfvs.info/contact-us/","hasForm":true,"observedAt":"2026-09-18T12:32:07.851Z"}],"matchedKeywords":[],"relevantKeywords":[],"priorityKeywords":[],"quality":[{"keyword":"veterinary","relevant":true,"evidenceLevel":"profile","role":"undetermined","flags":[],"sourceUrls":["https://www.youtube.com/channel/UCDhGyoCkNlo3L6nwuRyNMsA"]},{"keyword":"veterinarian","relevant":tr