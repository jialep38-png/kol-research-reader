{"channelId":"UCuA2fasfCYYkZksznIqqVHA","row":["Dr Minnie the Veterinarian",459,"My name is Minnie and I am a veterinarian from the UK!\n\nI'm passionate about my profession and sharing it with the world! I will be making videos about all sorts of topics that will be accessible to everyone, whether you're a vet or not! \n\nI am also soon-to-be working with Sea Turtles in the Maldives and I'll be wanting to share everything I know and love about these incredible reptiles and I give you an idea of what it is like to live and work in a beautiful yet remote slice of paradise. \n\nI hope you enjoy and engage, and maybe even come away having learned a little something!\n\n(p.s. I am also a massive dork so I can't promise 100% educational content all the time....)","","United Kingdom"],"channelUrl":"https://www.youtube.com/channel/UCuA2fasfCYYkZksznIqqVHA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCuA2fasfCYYkZksznIqqVHA","observedAt":"2026-09-18T12:22:15.065Z","channelId":"UCuA2fasfCYYkZksznIqqVHA","sourceType":"about","contentHash":"71e06ed462a4396779815573394320cbad7a886e5dc6aaedc86fcdec46ab2e51","complete":true,"readStatus":"read","captureSha256":"e97b8243ce8995a8be2e63d1b8b5f49fa6059c0b1dc129e69a17c2f80dbb20ee"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCuA2fasfCYYkZksznIqqVHA","observedAt":"2026-09-18T12:22:15.065Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCuA2fasfCYYkZksznIqqVHA","identityStatus":"channel_published","value":459,"raw":"459 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCuA2fasfCYYkZksznIqqVHA","observedAt":"2026-09-18T12:22:15.065Z"}],"emails":[],"contactPages":[],"matchedKeywords":["veterinary"],"relevantKeywords":["veterinary"],"priorityKeywords":[],"quality":[{"keyword":"veterinary","relevant":false,"evidenceLevel":"single_sample","role":"undetermined","flags":[],"sourceUrls":["https://www.youtube.com/watch?v=5YPJ21uZnck"]}],"clean