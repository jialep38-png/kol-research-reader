{"channelId":"UCZj8DWmJ_zw1z2ypwF3d3kA","row":["Virginia-Maryland College of Veterinary Medicine",1290,"A leading biomedical teaching and research center established in 1978, Virginia Tech's Virginia-Maryland College of Veterinary Medicine enrolls more than 700 doctor of veterinary medicine, master of public health, and biomedical and veterinary sciences graduate students. The college is a partnership between land-grant universities Virginia Tech and the University of Maryland. Locations include the main campus in Blacksburg, Virginia; the Animal Cancer Care and Research Center in Roanoke, Virginia; the Marion duPont Scott Equine Medical Center in Leesburg, Virginia; and the Gudelsky Veterinary Center in College Park, Maryland.","andrewfjmann@vt.edu; awinemiller@vt.edu; kmyatt@vt.edu; marjorielee@vt.edu; mkbrown19@vt.edu; speart@vt.edu","United States"],"channelUrl":"https://www.youtube.com/channel/UCZj8DWmJ_zw1z2ypwF3d3kA","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCZj8DWmJ_zw1z2ypwF3d3kA","observedAt":"2026-09-18T12:04:22.407Z","channelId":"UCZj8DWmJ_zw1z2ypwF3d3kA","sourceType":"about","contentHash":"93afb699076132e789af41e76149d803e9ef2a54ec16061a41266c027af376e4","complete":true,"readStatus":"read","captureSha256":"9f59e063fc5882d6b159ec5885f2866dfdc0e742f9d0426b90dc3191e5c0a2d2"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCZj8DWmJ_zw1z2ypwF3d3kA","observedAt":"2026-09-18T08:00:22.245Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCZj8DWmJ_zw1z2ypwF3d3kA","identityStatus":"channel_published","value":1290,"raw":"1.29K subscribers","precision":"rounded","sourceUrl":"https://www.youtube.com/channel/UCZj8DWmJ_zw1z2ypwF3d3kA","observedAt":"2026-09-18T12:04:22.407Z"}],"emails":[{"address":"andrewfjmann@vt.edu","purpose":"unknown","ownerRole":"unknown","identityStatus":"cross_linked","sourceUrls":["https://vetmed.vt.edu/comms/contacts.html"],"evidenceIds":["public-page:5714d7520d6880c8c839