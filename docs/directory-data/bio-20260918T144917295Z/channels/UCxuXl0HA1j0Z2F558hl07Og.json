{"channelId":"UCxuXl0HA1j0Z2F558hl07Og","row":["Alturas Wildlife Rescue",361,"Alturas Wildlife Sanctuary is a refuge for injured, orphaned, and displaced animals near the coastal town of Dominical in Osa. Since our founding in 2014, we have rescued over 3,500 animals from three different conservation areas, covering 19% of Costa Rica’s land. Our key missions are to rescue, rehabilitate, and release wildlife back into their natural habitats.","tours@alturaswildlifesanctuary.org","Costa Rica"],"channelUrl":"https://www.youtube.com/channel/UCxuXl0HA1j0Z2F558hl07Og","biographySource":{"sourceUrl":"https://www.youtube.com/channel/UCxuXl0HA1j0Z2F558hl07Og","observedAt":"2026-09-18T12:05:12.564Z"},"countrySource":{"sourceUrl":"https://www.youtube.com/channel/UCxuXl0HA1j0Z2F558hl07Og","observedAt":"2026-09-18T12:05:12.564Z"},"followerAccounts":[{"platform":"youtube","url":"https://www.youtube.com/channel/UCxuXl0HA1j0Z2F558hl07Og","identityStatus":"channel_published","value":361,"raw":"361 subscribers","precision":"exact","sourceUrl":"https://www.youtube.com/channel/UCxuXl0HA1j0Z2F558hl07Og","observedAt":"2026-09-18T12:05:12.564Z"}],"emails":[{"address":"tours@alturaswildlifesanctuary.org","purpose":"unknown","ownerRole":"unknown","identityStatus":"cross_linked","sourceUrls":["https://www.alturaswildlifesanctuary.org/contact/"],"evidenceIds":["public-page:298bb025651217ea714494ff"],"observedAt":"2026-09-18T12:35:48.470Z","deliveryVerified":false,"dnsStatus":"unknown","context":"tours@alturaswildlifesanctuary.org","raw":"tours@alturaswildlifesanctuary.org"}],"contactPages":[{"url":"https://www.alturaswildlifesanctuary.org/","hasForm":true,"observedAt":"2026-09-18T12:35:47.497Z"},{"url":"https://www.alturaswildlifesanctuary.org/contact/","hasForm":true,"observedAt":"2026-09-18T12:35:48.470Z"},{"url":"https://www.alturaswildlifesanctuary.org/about-us/","hasForm":true,"observedAt":"2026-09-18T12:35:48.802Z"},{"url":"https://www.alturaswildlifesanctuary.org/join-our-team/","hasFo